# Copie para .env e preencha. Não commite valores reais.
#
# Referência: todas as variáveis lidas pelo backend (src/ e scripts de seed).

# --- Banco de dados ---
# Postgres. Em produção/QA use a URL do provedor (ex.: Neon).
# Para o Postgres local do docker-compose: postgresql://<user>:<senha>@localhost:5432/<db>
DATABASE_URL=

# Banco isolado usado apenas pelos testes automatizados. Precisa terminar em
# "_test" e nunca deve apontar para o banco de desenvolvimento (ver src/test/config.ts).
TEST_DATABASE_URL=

# --- Autenticação ---
# Chave de assinatura dos tokens JWT.
JWT_SECRET=
# Custo do hash do bcrypt (ex.: 10). Obrigatório: o signup falha sem ele.
BCRYPT_SALTS=

# --- Servidor ---
# Porta HTTP. Default no código: 4000.
PORT=4000

# --- Geocoding ---
# Chave da LocationIQ, usada na busca de endereços e geocoding reverso.
LOCATION_IQ_KEY=

# --- Upload de imagens ---
# Lida IMPLICITAMENTE pelo SDK do Cloudinary (`cloudinary.v2`), por isso não
# aparece num grep por `process.env`. Sem ela o upload de fotos de spot falha.
CLOUDINARY_URL=

# --- E-mail transacional (Resend) ---
# Sem RESEND_API_KEY o envio é simulado (apenas log, sem o conteúdo).
RESEND_API_KEY=
# Remetente; o domínio precisa estar verificado no Resend. Ex.: GoPicos <no-reply@seudominio.com>
EMAIL_FROM=
