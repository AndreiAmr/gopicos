# Copie para .env e preencha. Não commite valores reais.
#
# As variáveis `VITE_*` são embutidas no bundle durante `vite build`, portanto
# mudá-las exige um novo build (não são lidas em runtime).

# Token de acesso do Mapbox, usado para renderizar o mapa.
VITE_MAPBOX_ACCESS_TOKEN=

# URL base do backend, incluindo esquema e porta (sem barra no final).
# Ex.: https://api.exemplo.com
# Se ficar vazia, o app usa http://localhost:4000.
VITE_API_URL=
